# Capturas de pantalla y mockups de diseño locales
*.png

# EXCEPCIÓN IMPORTANTE: los iconos de la PWA y el apple-touch-icon SÍ deben
# versionarse. Si no, Cloudflare Pages despliega sin ellos y el manifest
# devuelve 404 en los iconos (la PWA deja de ser instalable).
!assets/img/icono-*.png

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores y entornos
.vscode/
.idea/
.claude/

# Estado local de las herramientas de IA (memoria de sesión, no es código fuente).
# El conocimiento duradero del proyecto vive versionado en .agents/memory/.
.workbuddy-ai/
.freebuff/

# Python / cachés
__pycache__/
*.py[cod]

# Anti-spam del formulario (registro de envíos por IP).
# Se ignora el contenido, pero NO el .htaccess que lo protege:
# así la protección viaja con el repositorio.
tmp-log/*
!tmp-log/.htaccess

# Salida del build para Cloudflare Pages (la genera build.sh)
dist/
